#!/bin/sh
set -eu

usage() {
    echo "usage: release/export <source-commit> <new-output-directory>" >&2
    exit 2
}

[ "$#" -eq 2 ] || usage

source_revision=$1
destination=$2
repository=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
manifest="$repository/release/public-files.txt"

case "$destination" in
    /*) ;;
    *)
        echo "release output must be an absolute path" >&2
        exit 2
        ;;
esac

cd "$repository"
commit=$(git rev-parse --verify "$source_revision^{commit}") || {
    echo "source revision is not a commit: $source_revision" >&2
    exit 2
}

[ ! -e "$destination" ] || {
    echo "release output already exists: $destination" >&2
    exit 2
}

parent=$(dirname -- "$destination")
[ -d "$parent" ] || {
    echo "release output parent does not exist: $parent" >&2
    exit 2
}

stage=$(mktemp -d "$parent/.public-release.XXXXXX")
cleanup() {
    if [ -n "${stage:-}" ] && [ -d "$stage" ]; then
        rm -rf -- "$stage"
    fi
}
trap cleanup EXIT HUP INT TERM

set -- "$commit"
while IFS= read -r path || [ -n "$path" ]; do
    case "$path" in
        ""|\#*) continue ;;
    esac
    case "$path" in
        "."|/*|*..*|*//*|*[!A-Za-z0-9._/-]*)
            echo "invalid public allowlist path: $path" >&2
            exit 2
            ;;
    esac
    git cat-file -e "$commit:$path" 2>/dev/null || {
        echo "allowlisted path is missing from $commit: $path" >&2
        exit 2
    }
    set -- "$@" "$path"
done < "$manifest"

git archive --format=tar "$@" | tar -xf - -C "$stage"

if find "$stage" -type l -print -quit | grep -q .; then
    echo "public release contains a symbolic link" >&2
    exit 1
fi

if find "$stage" \( -name codex_journal.md -o -name codex_journal.d \) \
    -print -quit | grep -q .; then
    echo "public release contains private journal material" >&2
    exit 1
fi

printf '%s\n' "$commit" > "$stage/SOURCE_REVISION"
mv -- "$stage" "$destination"
stage=

echo "$destination"
